# Kopieren nach .env und bei Bedarf anpassen.
# Die Werte entsprechen einer frischen XAMPP-Installation (root ohne Passwort).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kinoarena_development
DB_TEST_NAME=kinoarena_test

# API-Server
PORT=3000
# Basis-URL fuer Links in E-Mails (im Entwicklungsmodus der Vite-Server).
# Beginnt sie mit https://, wird das Session-Cookie als Secure gesetzt.
APP_URL=http://localhost:5173

# In Produktion zwingend auf lange Zufallswerte setzen, z. B.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-session-secret-bitte-aendern
TOKEN_SECRET=dev-token-secret-bitte-aendern

# Hinter einem Reverse Proxy auf 1 setzen, damit req.ip die echte Client-IP liefert
TRUST_PROXY=0
